{
  "_comment": "路由配置文件：启动时会聚合预检；非法 target 正则或显式非法资源值会在监听前失败，缺少供应商 Key 仅告警；修改配置、更换 ChatGPT 账号/API key/组织租户身份后都必须重启路由，以清空内存状态",
  "port": 15730,
  "proxy": {
    "_comment": "所有 viaProxy=true 的官方或自定义 HTTPS 通道共用此 HTTP CONNECT 代理；v2rayN 请填写 HTTP/混合端口",
    "host": "127.0.0.1",
    "port": 10808
  },
  "timeouts": {
    "connectMs": 15000,
    "responseHeaderMs": 120000,
    "streamIdleMs": 600000,
    "requestMs": 600000
  },
  "heartbeatMs": 15000,
  "maxRequestBytes": 67108864,
  "maxConcurrentRequests": 8,
  "maxBufferedRequestBytes": 134217728,
  "providerPool": {
    "_comment": "同一模型配置多条同 wireApi target 时记录成功供应商；stateDomain 只允许相同 wireApi 共享，Chat/Responses 始终分域；亲和键仅保存 SHA-256",
    "maxEntries": 2048,
    "ttlMs": 86400000,
    "allowDefaultTarget": false,
    "modelAffinity": false
  },
  "responseHistory": {
    "_comment": "只缓存 previous_response_id 对应的工具调用；键仅保存 SHA-256，条目和全局字节均有硬上限，不保存完整对话正文",
    "maxEntries": 512,
    "maxEntryBytes": 1048576,
    "maxBytes": 16777216,
    "ttlMs": 86400000
  },
  "googleChannel": {
    "_comment": "谷歌订阅通道上下文自动精简：chat 请求 messages 序列化字节超过 contextSlimMaxBytes 时，丢弃最旧的完整旧轮次（system 前缀与最近上下文保留、tool 调用对不拆散），防止智能体每轮全量重发长会话撞上游分钟配额桶造成持续 429；设 0 关闭",
    "contextSlimMaxBytes": 1048576
  },
  "goalCheckpoint": {
    "_comment": "仅在 Chat 裁剪旧轮次时生成九栏目目标检查点；task/exact/response 外部键均保存为带类型域 SHA-256，response 索引另有独立 TTL/LRU 上限",
    "enabled": true,
    "maxEntries": 128,
    "maxResponseIdsPerTask": 128,
    "maxResponseIndexes": 16384,
    "ttlMs": 86400000,
    "sourceTokenBudget": 128000,
    "sourceWindowRatio": 0.2,
    "maxOutputTokens": 2048,
    "requestMs": 120000,
    "persistence": {
      "_comment": "冷重启恢复默认关闭；启用时必须显式填写文件路径，只保存九栏目摘要和哈希索引，不保存完整历史或凭据",
      "enabled": false,
      "path": null,
      "stateGeneration": "default",
      "debounceMs": 1000,
      "maxBytes": 16777216,
      "lockHeartbeatMs": 5000,
      "lockStaleMs": 30000
    }
  },
  "paths": {
    "auth": null,
    "catalog": null
  },
  "oauth": {
    "_comment": "viaProxy=null 时 token 刷新继承当前官方 target 的直连/代理策略；设为 true/false 可单独覆盖",
    "client_id": "app_EMoamEEZ73f0CkXaXp7hrann",
    "refresh_skew_seconds": 30,
    "viaProxy": null
  },
  "targets": [
    {
      "_comment": "官方模型示例为走代理；改为 false 即可直连，不影响登录态和 Responses 协议",
      "match": "^(gpt-|codex-|o\\d|computer-use)",
      "name": "openai",
      "platform": "openai",
      "host": "chatgpt.com",
      "prefix": "/backend-api/codex",
      "useOpenAiAuth": true,
      "viaProxy": true,
      "vision": true,
      "wireApi": "responses"
